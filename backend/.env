ENVIRONMENT=development
# JSON array of allowed origins (use double quotes)
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Postgres DSN (pgvector enabled image recommended)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/kimiti

# Vector backend: pgvector | qdrant | memory
VECTOR_BACKEND=pgvector
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# LLM provider: openai | ollama | vllm
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Embeddings via Ollama (default model in code if empty)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=

# Local inference base for Ollama (containers reach host via host.docker.internal)
INFERENCE_BASE_URL=http://host.docker.internal:11434
INFERENCE_MODEL=llama3

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Data + DVC
DATA_DIR=/data
DVC_ENABLED=false
