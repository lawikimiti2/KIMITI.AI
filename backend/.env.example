ENVIRONMENT=development
# JSON array with double quotes; no single quotes
CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Postgres DSN (pgvector enabled image recommended)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/kimiti

# Vector backend: pgvector | qdrant | memory
VECTOR_BACKEND=pgvector
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# LLM provider: openai | ollama | vllm
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Alternative local inference (Ollama/vLLM OpenAI-compatible)
INFERENCE_BASE_URL=
INFERENCE_MODEL=

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Data + DVC
DATA_DIR=/data
DVC_ENABLED=false
